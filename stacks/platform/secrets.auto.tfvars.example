# Copy to secrets.auto.tfvars (ignored by git). OpenTofu loads it automatically.
# Everything secret lives here, terraform.tfvars can be committed.

secrets = {
  # Read only deploy keys, by git url.
  deploy_keys = {
    "git@github.com:Sothyr/vereins-pages.git" = <<-EOT
      -----BEGIN OPENSSH PRIVATE KEY-----
      ...
      -----END OPENSSH PRIVATE KEY-----
    EOT
  }
  # Password of the smarthost of the platform relay, by sothyr host.
  smarthost_passwords = { sothyr-1 = "..." }
  # Club values that are secret, by "host/slug".
  site_env = {
    "sothyr-1/bodensee-players" = { GOOGLE_API_KEY = "...", PRETIX_ADMIN_PASSWORD = "..." }
  }
  # Off-site backup by host: S3 key of the bucket and the restic password. Keep the restic password in your
  # password manager too: without it the copies cannot be read. Letters, digits and . _ / + = - only.
  offsite = {
    sothyr-1 = { access_key = "...", secret_key = "...", password = "..." }
  }
  # Secret files and env of apps, by app name.
  app_files = {
    registry = { "htpasswd" = "ci:$2y$05$...\nvm:$2y$05$...\n" }
  }
}

registries = {
  "ghcr.io" = { username = "florianxschweitzer", password = "ghp_..." }
}
