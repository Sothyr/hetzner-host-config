#!/bin/bash
# Generated by OpenTofu (module host-runtime). Brings the host to the declared state. Safe to run again.
set -euo pipefail
umask 077

${lib}

hhc_wait_bootstrap

# SSH CA and login users
hhc_begin
hhc_put /etc/ssh/hhc_user_ca.pub 0644 '${ca_keys}'
if hhc_changed; then sshd -t && systemctl reload sshd; fi
hhc_users_sync '${admin_user}' "$(printf '%s' '${users}' | base64 -d)"
sshd -t

# Tools, units, registry logins
hhc_begin
hhc_put /usr/local/libexec/hhc/stack 0755 '${stack_sh}'
hhc_put /etc/systemd/system/hhc-stack@.service 0644 '${stack_unit}'
hhc_put /etc/systemd/system/hhc-stack-update.service 0644 '${update_unit}'
hhc_put /etc/systemd/system/hhc-stack-update.timer 0644 '${update_timer}'
hhc_put /etc/hhc/registry-auth.json 0600 '${registry_auth}'
%{ for name, s in stacks ~}
hhc_put '/etc/systemd/system/hhc-stack@${name}.service.d/10-hhc.conf' 0644 '${s.dropin}'
%{ endfor ~}
hhc_changed && hhc_daemon_reload
systemctl enable -q --now hhc-stack-update.timer

hhc_firewalld_ports '${firewalld_ports}'

%{ for name, internal in networks ~}
hhc_network '${name}' '${internal}'
%{ endfor ~}

# Stacks, pass 1: files, checkouts and patches of every stack. Nothing starts yet,
# so a stack that requires another one finds it complete.
declare -A HHC_STACK_DIRTY=()
%{ for name, s in stacks ~}
hhc_stack_begin '${name}'
hhc_begin
hhc_put '/srv/stacks/${name}/hhc.conf' 0600 '${s.conf}'
hhc_put '/srv/stacks/${name}/hhc.env' 0600 '${s.env}'
hhc_put '/srv/stacks/${name}/hhc.jobs.env' 0600 '${s.jobs_env}'
%{ if s.deploy_key != "" ~}
hhc_put '/srv/stacks/${name}/deploy_key' 0600 '${s.deploy_key}'
%{ endif ~}
hhc_stack_mark
%{ for path, c in s.checkouts ~}
%{ if c.key != "" ~}
hhc_put '/srv/stacks/${name}/keys/${c.id}' 0600 '${c.key}'
%{ endif ~}
%{ endfor ~}
hhc_stack_mark
%{ if s.git != null ~}
hhc_git_sync '${name}' '/srv/stacks/${name}/src' '${s.git.url}' '${s.git.ref}' '${s.deploy_key != "" ? "/srv/stacks/${name}/deploy_key" : ""}'
%{ endif ~}
%{ for path, c in s.checkouts ~}
hhc_git_sync '${name}' '${s.workdir}/${path}' '${c.url}' '${c.ref}' '${c.key != "" ? "/srv/stacks/${name}/keys/${c.id}" : ""}'
%{ endfor ~}
%{ if s.post != "" ~}
hhc_stack_post '${name}' '${s.post}'
%{ endif ~}
hhc_begin
%{ for path, f in s.files ~}
hhc_put '${s.workdir}/${path}' ${f.mode} '${f.content}'
%{ endfor ~}
hhc_stack_mark
HHC_STACK_DIRTY['${name}']="$HHC_STACK_CHANGED"

%{ endfor ~}
# Stacks, pass 2: start or apply. systemd starts required stacks first.
# A stack that was not running is started once, even when a dependent stack already pulled it up.
declare -A HHC_STACK_WAS_ACTIVE=()
%{ for name, s in stacks ~}
HHC_STACK_WAS_ACTIVE['${name}']="$(systemctl is-active -q 'hhc-stack@${name}.service' && echo 1 || echo 0)"
%{ endfor ~}
%{ for name, s in stacks ~}
HHC_STACK_CHANGED="$${HHC_STACK_DIRTY['${name}']}"
hhc_stack_end '${name}' "$${HHC_STACK_WAS_ACTIVE['${name}']}"
%{ endfor ~}
hhc_stacks_prune "$(printf '%s' '${stack_names}' | base64 -d)"

%{ if edge != null ~}
# Edge routes
EDGE_DIR="$(hhc_edge_dir '${edge.volume}' '${edge.dir}')"
hhc_edge_backup "$EDGE_DIR"
hhc_begin
%{ for name, content in routes ~}
hhc_put "$EDGE_DIR/hhc-${name}.caddy" 0644 '${content}'
%{ endfor ~}
hhc_prune "$EDGE_DIR" 'hhc-*.caddy' "$(printf '%s' '${route_paths}' | base64 -d | sed "s|^|$EDGE_DIR/|")"
hhc_edge_apply "$EDGE_DIR" '${edge.container}' '${edge.caddyfile}'
%{ endif ~}

# Backups
hhc_begin
hhc_put /usr/local/libexec/hhc/backup 0755 '${backup_sh}'
%{ for name, cmd in backup_jobs ~}
hhc_put '/etc/hhc/backup-jobs/${name}.sh' 0600 '${cmd}'
%{ endfor ~}
hhc_prune /etc/hhc/backup-jobs '*.sh' "$(printf '%s' '${backup_paths}' | base64 -d)"
hhc_backup_setup '${backup.on_calendar}' '${backup.keep_days}'
%{ if offsite != null ~}
hhc_offsite_setup '${offsite.on_calendar}' '${offsite.script}' '${offsite.env}' '${offsite.paths}'
%{ else ~}
hhc_offsite_remove
%{ endif ~}

%{ if haproxy != "" ~}
# Entry point
hhc_haproxy_apply '${haproxy}'
%{ endif ~}

log "host is up to date"
